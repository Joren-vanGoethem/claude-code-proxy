# Example profile: Z.ai Coding Plan. Copy this directory to profiles/<name>/,
# rename this file to .env and fill in the key.

PROXY_HOST=127.0.0.1
# Every profile needs its own port.
PROXY_PORT=8083

SESSION_RETENTION_LIMIT=1000

# Use the Coding Plan endpoint. The general /api/paas/v4 and /api/v1 endpoints
# answer 403 "Permission denied" to a Coding Plan key.
OPENAI_API_KEY="your-zai-api-key"
OPENAI_BASE_URL="https://api.z.ai/api/coding/paas/v4"
